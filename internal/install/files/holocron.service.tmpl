# holocron, written by `holocron install` (SPEC.md § 9.2). Changes here
# are overwritten on the next install.
[Unit]
Description=holocron: web search and page fetch for AI agents
Wants=network-online.target
After=network-online.target

[Service]
User=holocron
Group=holocron
{{- range .Keys}}
{{- if .Encrypted}}
# {{.Name}}'s key, encrypted at rest (systemd-creds): systemd decrypts it
# where only this service reads it, as $CREDENTIALS_DIRECTORY/{{.Name}}-key.
LoadCredentialEncrypted={{.Name}}-key:{{.Path}}
{{- else}}
# {{.Name}}'s key, a plain 0600 file: systemd copies it where only this
# service reads it. `holocron key set {{.Name}}` encrypts it.
LoadCredential={{.Name}}-key:{{.Path}}
{{- end}}
{{- end}}
# All addresses: the deployment's firewall decides who reaches it.
ExecStart=/usr/local/bin/holocron serve --listen 0.0.0.0:8080 --search {{.Search}} --context {{.Context}} --fetch {{.Fetch}}
Restart=on-failure
RestartSec=2s
MemoryMax=768M
Environment=GOMEMLIMIT=600MiB
TasksMax=96

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
